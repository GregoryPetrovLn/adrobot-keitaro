# ---- Keitaro ----
# Base URL of the tracker (no trailing slash). The admin API lives at $KEITARO_BASE_URL/admin_api/v1
KEITARO_BASE_URL=https://in.posdk.xyz
# Personal API key: Keitaro admin -> Профиль -> API ключи
KEITARO_API_KEY=replace-me
KEITARO_TIMEOUT=30.0

# ---- Defaults used by the campaign creator ----
# Optional. If unset, the UI asks you to pick from the dictionaries loaded from Keitaro.
DEFAULT_TRAFFIC_SOURCE_ID=
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
# Prefix applied to every campaign name/alias created by this app.
CAMPAIGN_NAME_PREFIX=

# Where Flow 1 sends matching geo traffic
GOOGLE_REDIRECT_URL=https://www.google.com

# ---- Application ----
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@localhost:5432/adrobot
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
